# We are using Photon 2.0 (Beta) — https://app.beta.photon.codes

PHOTON_PROJECT_ID=pho_prj_...
PHOTON_API_KEY=

# this is the agent assigned to respond to your phone number
PHOTON_AGENT_HANDLE=+1...
# this is the phone number you text from
PHOTON_TEST_SENDER=+1...
# shared secret for internal service calls
INTERNAL_TOKEN=

# Gemini classifier — https://aistudio.google.com/apikey
# Without a key, replies are labeled by the keyword rules. With one, Gemini labels them and falls back
# to the keyword rules on errors, timeouts and rate limits. GEMINI_KEY also works, here or in backend/.env.
GEMINI_API_KEY=
# Set to keyword to turn Gemini off without removing the key.
CLASSIFIER=gemini
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# Outbound timing
# The school's time zone for quiet hours (8pm-8am, when check-ins and plan messages are held).
SCHOOL_TIMEZONE=America/Los_Angeles
# Set to off to send check-ins at any hour, for testing or a late demo.
QUIET_HOURS=on

# Paging on-call staff about safety cases (roster is on the On-call page)
# School hours decide who is paged first: counselor during them, administrator outside them.
SCHOOL_HOURS=08:00-15:30
# mon-fri (default) or all. Use all for a weekend demo, or only administrators are paged.
SCHOOL_DAYS=mon-fri

# ---- Demo mode (backup for a live demo) ----
# 1 = the scripted demo runs with no network: recorded Gemini answers, Photon off, and a
# "Play next message" bar on every page. Also sets DEMO_STORY=live and QUIET_HOURS=off.
DEMO_MODE=0

# ---- Why Absent demo settings (PRD 2) ----

# full = all seed replies loaded | live = Route 7 cluster appears when the demo family's reply arrives
DEMO_STORY=live
# rules = clean demo clusters | auto = statistical scan + rules | scan = scan only
CLUSTER_METHOD=rules
# demo = curated school | sim = simulated Lyon school (real contact network)
DATASET=demo
