# We are usign Photon 2.0 (Beta) — https://app.beta.photon.codes

PHOTON_PROJECT_ID=pho_prj_...
PHOTON_API_KEY=

# this is the agent assigned to respond to your phone number
PHOTON_AGENT_HANDLE=+1...
# this is the phone number you text from
PHOTON_TEST_SENDER=+1...
# shared secret for internal service calls
INTERNAL_TOKEN=

# Gemini classifier — https://aistudio.google.com/apikey
# Without a key, replies are labeled by the keyword rules.
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=
