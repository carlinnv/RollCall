# We are usign Photon 2.0 (Beta) — https://app.beta.photon.codes

# ask Carlin for these
PHOTON_PROJECT_ID=pho_prj_...
PHOTON_API_KEY=

# this is the agent assigned to respond to your phone number
PHOTON_AGENT_HANDLE=+1...
# this is the phone number you text from
PHOTON_TEST_SENDER=+1...
# shared secret for internal service calls
INTERNAL_TOKEN=

# ---- Why Absent demo settings (PRD 2) ----
# Gemini key goes in backend/.env (GEMINI_API_KEY=...); get one at https://aistudio.google.com/apikey
# keyword | gemini  (gemini needs the key; falls back to keywords on errors and rate limits)
CLASSIFIER=gemini
# full = all seed replies loaded | live = Route 7 cluster appears when the demo family's reply arrives
DEMO_STORY=live
# rules = clean demo clusters | auto = statistical scan + rules | scan = scan only
CLUSTER_METHOD=rules
# demo = curated school | sim = simulated Lyon school (real contact network)
DATASET=demo
