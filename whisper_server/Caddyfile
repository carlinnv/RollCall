# Caddy terminates HTTPS (automatic Let's Encrypt certificate) and proxies to the whisper container.
# WHISPER_DOMAIN comes from .env, e.g. whisper.example.org or 203-0-113-7.sslip.io
{$WHISPER_DOMAIN} {
	request_body {
		max_size 11MB
	}
	reverse_proxy whisper:8000 {
		transport http {
			read_timeout 120s
		}
	}
	header -Server
	# No access log on purpose: nothing about the requests is stored on the server.
}
